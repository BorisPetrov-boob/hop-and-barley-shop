# Скопируйте в .env и при необходимости поправьте значения.
# --------------------------------------------------------------------------- #
# Django
# --------------------------------------------------------------------------- #
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-secret-key-change-me-to-something-long-and-random
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# База данных (используется docker-compose; локально можно указать свой URL)
# --------------------------------------------------------------------------- #
POSTGRES_DB=hopbarley
POSTGRES_USER=hopbarley
POSTGRES_PASSWORD=hopbarley
POSTGRES_PORT=5432
DATABASE_URL=postgres://hopbarley:hopbarley@db:5432/hopbarley

# --------------------------------------------------------------------------- #
# Порты и демо-данные
# --------------------------------------------------------------------------- #
WEB_PORT=8000
SEED_DEMO=1

# --------------------------------------------------------------------------- #
# JWT
# --------------------------------------------------------------------------- #
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --------------------------------------------------------------------------- #
# Почта (по умолчанию письма печатаются в консоль)
# --------------------------------------------------------------------------- #
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=shop@hopbarley.local
ORDER_ADMIN_EMAIL=manager@hopbarley.local

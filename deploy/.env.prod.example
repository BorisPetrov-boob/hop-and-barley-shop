# Скопировать в  .env.prod  (в корне репозитория) и заполнить.
#   cp deploy/.env.prod.example .env.prod
# Файл .env.prod в .gitignore — не коммитить.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# сгенерировать:  python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_ДЛИННУЮ_СТРОКУ
DJANGO_DEBUG=0

# IP сервера (или домен). Можно перечислить через запятую.
DJANGO_ALLOWED_HOSTS=SERVER_IP
DJANGO_CSRF_TRUSTED_ORIGINS=http://SERVER_IP

# --- HTTP-only деплой на голый IP: ослабляем небезопасные-по-HTTP параметры ---
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
# (при переходе на HTTPS вернуть всё в 1 / убрать эти строки)

# --- PostgreSQL ---
POSTGRES_DB=hopbarley
POSTGRES_USER=hopbarley
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_СЛОЖНЫЙ_ПАРОЛЬ
DATABASE_URL=postgres://hopbarley:ЗАМЕНИТЬ_НА_СЛОЖНЫЙ_ПАРОЛЬ@db:5432/hopbarley

# --- Демо-данные при первом запуске (12 товаров, buyer@example.com / buyerpass123) ---
SEED_DEMO=1

# --- GraphiQL-IDE в браузере на /graphql/ (резолверы всё равно требуют is_staff) ---
GRAPHIQL_ENABLED=1

# --- Почта: по умолчанию письма пишутся в лог контейнера ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=shop@hopbarley.local
ORDER_ADMIN_EMAIL=manager@hopbarley.local

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
